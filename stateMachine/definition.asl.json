{
  "Comment": "Find Me A Job Workflow",
  "StartAt": "Manual Workflow Approval",
  "States": {
    "Manual Workflow Approval": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Arguments": {
        "FunctionName": "${manualWorkflowApprovalFunctionARN}",
        "Payload": {
          "task_token": "{% $states.context.Task.Token %}"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Comment": "Workflow Execution Rejected",
          "Next": "Workflow Rejected"
        }
      ],
      "Next": "Workflow Approved"
    },
    "Workflow Approved": {
      "Type": "Pass",
      "End": true,
      "Comment": "Workflow was approved by the user!"
    },
    "Workflow Rejected": {
      "Type": "Pass",
      "End": true,
      "Comment": "Workflow was rejected by the user!"
    }
  },
  "QueryLanguage": "JSONata"
}